Q52: Write a program to print the following pattern:

*

*
*
*

*
*
*
*
*

*
*
*

*



/*
Sample Test Cases:
Input 1:

Output 1:
Pattern with stars spaced irregularly as shown.

*/








#include <stdio.h>

int main() {
    // First group
    for (int i = 1; i <= 4; i++) {
        printf("*\n");
    }

    printf("\n");

    // Second group
    for (int i = 1; i <= 5; i++) {
        printf("*\n");
    }

    printf("\n");

    // Third group
    for (int i = 1; i <= 3; i++) {
        printf("*\n");
    }

    printf("\n");

    // Fourth group
    printf("*\n");

    return 0;
}
