Q43: Write a program to check if a number is a strong number.

/*
Sample Test Cases:
Input 1:
145
Output 1:
Strong number

Input 2:
123
Output 2:
Not strong number

*/





#include <stdio.h>

int main() {
    int n, original, digit;
    int i, factorial, sum = 0;

    scanf("%d", &n);

    original = n;

    while (n != 0) {
        digit = n % 10;

        factorial = 1;

        for (i = 1; i <= digit; i++) {
            factorial = factorial * i;
        }

        sum = sum + factorial;

        n = n / 10;
    }

    if (sum == original) {
        printf("Strong number");
    } else {
        printf("Not strong number");
    }

    return 0;
}






